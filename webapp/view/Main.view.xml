<mvc:View
    controllerName="com.abics.supplierportal.controller.Main"
    displayBlock="true"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:mvc="sap.ui.core.mvc">

    <Page
        id="page"
        showHeader="false"
        enableScrolling="false">

        <content>

            <!-- Tam ekran Bremen arka planı -->
            <core:HTML
                content='&lt;img src="images/bremen.jpg"
                style="position:fixed;
                       top:0;
                       left:0;
                       width:100vw;
                       height:100vh;
                       object-fit:cover;
                       z-index:0;" /&gt;' />

            <!-- Ana ekran düzeni -->
            <HBox
                id="mainLayout"
                fitContainer="true"
                width="100%"
                height="100%"
                alignItems="Stretch">

                <!-- SOL / KARŞILAMA ALANI -->
                <VBox
                    id="welcomeArea"
                    width="100%"
                    height="100%"
                    justifyContent="Center"
                    alignItems="Center">

                    <Image
                        src="images/logo.png"
                        width="420px"
                        densityAware="false"
                        class="sapUiMediumMarginBottom" />

                    <HBox justifyContent="Center">

                        <Button
                            id="loginButton"
                            text="{i18n>loginButton}"
                            type="Emphasized"
                            width="10rem"
                            press=".onLoginPress"
                            class="sapUiTinyMarginEnd" />

                        <Button
                            id="registerButton"
                            text="{i18n>registerButton}"
                            type="Emphasized"
                            width="10rem"
                            press=".onRegisterPress"
                            class="sapUiTinyMarginBegin" />
                    </HBox>

                </VBox>


                <!-- SAĞ / LOGIN ALANI -->
                <VBox
                    id="loginArea"
                    visible="false"
                    width="32rem"
                    height="100%"
                    justifyContent="Center"
                    class="sapUiLargeMarginEnd">

                    <Panel
                        width="100%"
                        height="32rem"
                        backgroundDesign="Solid">

                        <VBox
                            width="100%"
                            class="sapUiContentPadding">

                            <!-- Başlık -->
                            <HBox
                                width="100%"
                                justifyContent="SpaceBetween"
                                alignItems="Center"
                                class="sapUiMediumMarginBottom">

                                <Title
                                    text="{i18n>loginButton}"
                                    level="H2" />

                                <Button
                                    icon="sap-icon://decline"
                                    type="Transparent"
                                    press=".onCloseLoginPress" />

                            </HBox>

                            <!-- E-Mail -->
                            <Label
                                text="E-Mail"
                                class="sapUiTinyMarginBottom" />

                            <Input
                                id="loginEmail"
                                type="Email"
                                placeholder="E-Mail"
                                width="100%"
                                class="sapUiMediumMarginBottom" />

                            <!-- Password -->
                            <Label
                                text="Password"
                                class="sapUiTinyMarginBottom" />

                            <Input
                                id="loginPassword"
                                type="Password"
                                placeholder="Password"
                                width="100%"
                                class="sapUiMediumMarginBottom" />

                            <!-- Login -->
                            <Button
                                text="{i18n>loginButton}"
                                type="Emphasized"
                                width="100%" />

                        </VBox>

                    </Panel>

                </VBox>
                <!-- SAĞ / REGISTER ALANI -->
                <VBox
                    id="registerArea"
                    visible="false"
                    width="32rem"
                    height="100%"
                    justifyContent="Center"
                    class="sapUiLargeMarginEnd">

                    <Panel
                        width="100%"
                        height="32rem"
                        backgroundDesign="Solid">

                        <VBox
                            id="registerForm"
                            width="100%"
                            class="sapUiContentPadding">

                            <!-- Başlık -->
                            <HBox
                                width="100%"
                                justifyContent="SpaceBetween"
                                alignItems="Center"
                                class="sapUiMediumMarginBottom">

                                <Title
                                    text="{i18n>registerButton}"
                                    level="H2" />

                                <Button
                                    icon="sap-icon://decline"
                                    type="Transparent"
                                    press=".onCloseRegisterPress" />

                            </HBox>

                            <!-- E-Mail -->
                            <Label
                                text="E-Mail"
                                class="sapUiTinyMarginBottom" />

                            <Input
                                id="registerEmail"
                                type="Email"
                                placeholder="E-Mail"
                                width="100%"
                                class="sapUiSmallMarginBottom" />

                            <!-- Password -->
                            <Label
                                text="Password"
                                class="sapUiTinyMarginBottom" />

                            <Input
                                id="registerPassword"
                                type="Password"
                                placeholder="Password"
                                width="100%"
                                liveChange=".onPasswordLiveChange"
                                class="sapUiSmallMarginBottom" />

                            <!-- Confirm Password -->
                            <Label
                                text="Confirm Password"
                                class="sapUiTinyMarginBottom" />

                            <Input
                                id="registerPasswordConfirm"
                                type="Password"
                                placeholder="Confirm Password"
                                width="100%"
                                liveChange=".onConfirmPasswordLiveChange"
                                class="sapUiSmallMarginBottom" />

                            <ObjectStatus
                                id="passwordMatchStatus"
                                text="Passwords do not match"
                                state="Error"
                                icon="sap-icon://decline"
                                visible="false"
                                class="sapUiSmallMarginBottom" />

                            <!-- Password requirements -->
                            <VBox
                                id="passwordRules"
                                visible="false"
                                class="sapUiSmallMarginBottom">

                                <Text
                                    text="Password must contain:"
                                    class="sapUiTinyMarginBottom" />

                                <ObjectStatus
                                    id="ruleLength"
                                    text="At least 8 characters"
                                    state="Error"
                                    icon="sap-icon://decline" />

                                <ObjectStatus
                                    id="ruleUppercase"
                                    text="One uppercase letter"
                                    state="Error"
                                    icon="sap-icon://decline" />

                                <ObjectStatus
                                    id="ruleLowercase"
                                    text="One lowercase letter"
                                    state="Error"
                                    icon="sap-icon://decline" />

                                <ObjectStatus
                                    id="ruleNumber"
                                    text="One number"
                                    state="Error"
                                    icon="sap-icon://decline" />

                                <ObjectStatus
                                    id="ruleSpecial"
                                    text="One special character"
                                    state="Error"
                                    icon="sap-icon://decline" />

                            </VBox>

                            <!-- Register -->
                            <Button
                                text="{i18n>registerButton}"
                                type="Emphasized"
                                width="100%" 
                                press=".onRegisterSubmit" />

                        </VBox>
                        <VBox
                            id="registerSuccessArea"
                            visible="false"
                            width="100%"
                            height="100%"
                            alignItems="Center"
                            justifyContent="Center">

                            <core:Icon
                                src="sap-icon://accept"
                                size="4rem"
                                color="#107E3E"
                                class="sapUiMediumMarginBottom" />

                            <Title
                                text="Check your e-mail"
                                level="H2"
                                class="sapUiSmallMarginBottom" />

                            <Text
                                text="We sent you a verification link. Please check your inbox to verify your account."
                                textAlign="Center"
                                width="24rem" />

                        </VBox>
                    </Panel>

                </VBox>
            </HBox>

        </content>

    </Page>

</mvc:View>