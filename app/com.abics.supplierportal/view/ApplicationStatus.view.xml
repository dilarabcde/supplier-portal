<mvc:View
    controllerName="com.abics.supplierportal.controller.ApplicationStatus"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page
        id="applicationStatusPage"
        title="{i18n>applicationStatusTitle}">

<content>

    <Image
        src="{assets>/bannerUrl}"
        width="100%"
        height="22rem"
        densityAware="false" />

    <VBox class="sapUiMediumMargin">

        <!-- Sayfa Başlığı -->
        <Title
            text="{i18n>applicationStatusTitle}"
            level="H2" />

        <Text
            text="{i18n>applicationStatusDescription}" />


                <!-- Başvuru Bilgileri -->
                <Panel class="sapUiMediumMarginTop">

                    <content>

                        <Title
                            text="{application>/companyName}"
                            level="H3" />

                        <HBox class="sapUiSmallMarginTop">

                            <!-- Sol taraf -->
                            <VBox width="50%">

                                <Label text="{i18n>contactPerson}" />

                                <Text
                                    text="{application>/contactPerson}" />

                                <Label
                                    text="{i18n>email}"
                                    class="sapUiSmallMarginTop" />

                                <Text
                                    text="{application>/email}" />

                            </VBox>


                            <!-- Sağ taraf -->
                            <VBox width="50%">

                                <Label text="{i18n>category}" />

                                <Text
                                    text="{application>/category}" />

                                <Label
                                    text="{i18n>status}"
                                    class="sapUiSmallMarginTop" />

                            <ObjectStatus
                                text="{application>/statusText}"
                                state="{application>/statusState}" />

                            </VBox>

                        </HBox>

                    </content>

                </Panel>
<MessageStrip
    text="{application>/statusMessage}"
    type="{application>/statusMessageType}"
    showIcon="false"
    showCloseButton="false"
    class="sapUiMediumMarginTop" />

<!-- Onay Durumu -->
<Panel
    headerText="{i18n>approvalStatus}"
    class="sapUiMediumMarginTop">

    <content>

        <HBox
            width="100%"
            alignItems="Center"
            justifyContent="Center"
            wrap="Wrap"
            class="sapUiMediumMarginTopBottom">

            <!-- SOL: DURUM ADIMLARI -->
            <HBox
                width="{= ${application>/isRejected} ? '60%' : '100%' }"
                justifyContent="Center"
                alignItems="Center">

                <!-- 1 - Gönderildi -->
                <VBox
                    width="8rem"
                    alignItems="Center">

                    <Avatar
                        displayShape="Circle"
                        displaySize="S"
                        src="sap-icon://accept"
                        backgroundColor="Accent8" />

                    <ObjectStatus
                        text="{i18n>submitted}"
                        state="{application>/submittedState}"
                        class="sapUiSmallMarginTop" />

                </VBox>

                <core:Icon
                    src="sap-icon://navigation-right-arrow"
                    size="1.25rem"
                    class="sapUiSmallMarginBeginEnd" />

                <!-- 2 - İnceleme -->
                <VBox
                    width="8rem"
                    alignItems="Center">

                    <Avatar
                        displayShape="Circle"
                        displaySize="S"
                        src="{= ${application>/isReviewCompleted} ? 'sap-icon://accept' : 'sap-icon://inspection' }"
                        backgroundColor="{= ${application>/isReviewCompleted} ? 'Accent8' : ${application>/isUnderReview} ? 'Accent1' : 'Transparent' }" />

                    <ObjectStatus
                        text="{= ${application>/isReviewCompleted} ? ${i18n>reviewed} : ${i18n>underReview} }"
                        state="{application>/reviewState}"
                        class="sapUiSmallMarginTop" />

                </VBox>

                <core:Icon
                    src="sap-icon://navigation-right-arrow"
                    size="1.25rem"
                    class="sapUiSmallMarginBeginEnd" />

                <!-- 3 - Sonuç -->
                <VBox
                    width="8rem"
                    alignItems="Center">

                    <Avatar
                        displayShape="Circle"
                        displaySize="S"
                        src="{= ${application>/isRejected} ? 'sap-icon://decline' : 'sap-icon://complete' }"
                        backgroundColor="{= ${application>/isApproved} ? 'Accent8' : ${application>/isRejected} ? 'Accent2' : 'Transparent' }" />

                    <ObjectStatus
                        text="{= ${application>/isApproved} ? ${i18n>approved} : ${application>/isRejected} ? ${i18n>rejected} : ${i18n>result} }"
                        state="{application>/resultState}"
                        class="sapUiSmallMarginTop" />

                </VBox>

            </HBox>


            <!-- SAĞ: SADECE REDDEDİLDİĞİNDE -->
            <VBox
                width="35%"
                alignItems="Center"
                justifyContent="Center"
                visible="{application>/isRejected}">

                <core:Icon
                    src="sap-icon://edit"
                    size="2.5rem"
                    color="#BB0000"
                    class="sapUiSmallMarginBottom" />

                <Title
                    text="{i18n>revisionRequired}"
                    level="H4"
                    class="sapUiTinyMarginBottom" />

                <Text
                    text="{i18n>rejectedEditDescription}"
                    textAlign="Center"
                    width="100%"
                    class="sapUiSmallMarginBottom" />

                <Button
                    text="{i18n>editApplication}"
                    icon="sap-icon://edit"
                    type="Emphasized"
                    press=".onEditApplication" />

            </VBox>

        </HBox>

    </content>

</Panel>

            </VBox>

        </content>

    </Page>

</mvc:View>