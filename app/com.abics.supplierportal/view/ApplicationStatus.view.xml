<mvc:View
    controllerName="com.abics.supplierportal.controller.ApplicationStatus"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page
        id="applicationStatusPage"
        title="{i18n>applicationStatusTitle}">

<content>

    <Image
        src="{assets>/bannerUrl}"
        width="100%"
        height="22rem"
        densityAware="false" />

    <VBox class="sapUiMediumMargin">

        <!-- Sayfa Başlığı -->
        <Title
            text="{i18n>applicationStatusTitle}"
            level="H2" />

        <Text
            text="{i18n>applicationStatusDescription}" />


                <!-- Başvuru Bilgileri -->
                <Panel class="sapUiMediumMarginTop">

                    <content>

                        <Title
                            text="{application>/companyName}"
                            level="H3" />

                        <HBox class="sapUiSmallMarginTop">

                            <!-- Sol taraf -->
                            <VBox width="50%">

                                <Label text="{i18n>contactPerson}" />

                                <Text
                                    text="{application>/contactPerson}" />

                                <Label
                                    text="{i18n>email}"
                                    class="sapUiSmallMarginTop" />

                                <Text
                                    text="{application>/email}" />

                            </VBox>


                            <!-- Sağ taraf -->
                            <VBox width="50%">

                                <Label text="{i18n>category}" />

                                <Text
                                    text="{application>/category}" />

                                <Label
                                    text="{i18n>status}"
                                    class="sapUiSmallMarginTop" />

                            <ObjectStatus
                                text="{application>/statusText}"
                                state="{application>/statusState}" />

                            </VBox>

                        </HBox>

                    </content>

                </Panel>


                <!-- Onay Durumu -->
                <Panel
                    headerText="{i18n>approvalStatus}"
                    class="sapUiMediumMarginTop">

                    <content>

                        <HBox
                            justifyContent="Center"
                            alignItems="Center"
                            class="sapUiLargeMarginTopBottom">


                            <!-- 1 - Gönderildi -->
                            <VBox
                                width="10rem"
                                alignItems="Center">

                                <Avatar
                                    displayShape="Circle"
                                    displaySize="S"
                                    src="sap-icon://accept"
                                    backgroundColor="Accent8" />

                                    <ObjectStatus
                                        text="{i18n>submitted}"
                                        state="{application>/submittedState}"
                                        class="sapUiSmallMarginTop" />

                            </VBox>


                            <!-- Ok -->
                            <core:Icon
                                src="sap-icon://navigation-right-arrow"
                                size="1.5rem"
                                class="sapUiMediumMarginBeginEnd" />


                            <!-- 2 - İncelemede -->
                            <VBox
                                width="10rem"
                                alignItems="Center">

                                <Avatar
                                    displayShape="Circle"
                                    displaySize="S"
                                    src="{= ${application>/isReviewCompleted} ? 'sap-icon://accept' : 'sap-icon://inspection' }"
                                    backgroundColor="{= ${application>/isReviewCompleted} ? 'Accent8' : ${application>/isUnderReview} ? 'Accent1' : 'Transparent' }" />

                            <ObjectStatus
                                text="{= ${application>/isReviewCompleted} ? 'İncelendi' : 'İnceleniyor' }"
                                state="{application>/reviewState}"
                                class="sapUiSmallMarginTop" />

                            </VBox>


                            <!-- Ok -->
                            <core:Icon
                                src="sap-icon://navigation-right-arrow"
                                size="1.5rem"
                                class="sapUiMediumMarginBeginEnd" />


                            <!-- 3 - Sonuç -->
                            <VBox
                                width="10rem"
                                alignItems="Center">

                                <Avatar
                                    displayShape="Circle"
                                    displaySize="S"
                                    src="{= ${application>/isRejected} ? 'sap-icon://decline' : 'sap-icon://complete' }"
                                    backgroundColor="{= ${application>/isApproved} ? 'Accent8' : ${application>/isRejected} ? 'Accent2' : 'Transparent' }" />

                                <ObjectStatus
                                    text="{= ${application>/isApproved} ? 'Onaylandı' : ${application>/isRejected} ? 'Reddedildi' : 'Sonuç' }"
                                    state="{application>/resultState}"
                                    class="sapUiSmallMarginTop" />

                            </VBox>

                        </HBox>

                    </content>

                </Panel>

            </VBox>

        </content>

    </Page>

</mvc:View>