<mvc:View
    controllerName="com.abics.supplierportal.controller.Application"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:unified="sap.ui.unified">

    <Page
        id="applicationPage"
        showHeader="false">

        <content>

            <VBox width="100%">

                <!-- Üst bar -->
                <Toolbar>
                    <Image
                        src="images/logo.png"
                        width="6rem"
                        densityAware="false" />

                    <ToolbarSpacer />

                    <Text
                        id="loggedInUserEmail"
                        class="sapUiTinyMarginEnd" />

                    <Button
                        text="Çıkış"
                        icon="sap-icon://log"
                        type="Transparent" />
                </Toolbar>

                <!-- Üst görsel -->
                <Image
                    src="images/bremen-main.jpeg"
                    width="100%"
                    height="22rem"
                    densityAware="false" />

                <!-- Bilgilendirme -->
                <MessageStrip
                    text="Tedarikçi olarak kaydolmak için aşağıdaki formu doldurun. Gönderdikten sonra onay durumunu buradan takip edebilirsiniz."
                    type="Information"
                    showIcon="true"
                    showCloseButton="false"
                    class="sapUiSmallMargin" />

                <!-- Form alanı -->
                <VBox
                    width="100%"
                    class="sapUiMediumMargin">

                    <Title
                        text="{i18n>applicationFormTitle}"
                        level="H2"
                        class="sapUiSmallMarginBottom" />
                    <HBox
                        width="100%"
                        justifyContent="SpaceBetween"
                        alignItems="Start">

                        <VBox
                            width="49%">
                <Label
                    text="{i18n>companyName}"
                    required="true" />

                <Input
                    id="companyNameInput"
                    width="100%"
                    placeholder="{i18n>companyNamePlaceholder}" />

                <Label
                    text="{i18n>contactPerson}"
                    required="true" />

                <Input
                    id="contactPersonInput"
                    width="100%"
                    placeholder="{i18n>contactPersonPlaceholder}" />

                    <Label
                        text="{i18n>phone}" />

                    <HBox width="100%" alignItems="Center">
                        <Select
                            id="phoneCodeSelect"
                            width="6rem"
                            selectedKey="TR">
                            <items>
                                <core:Item key="TR" text="🇹🇷 +90" />
                                <core:Item key="DE" text="🇩🇪 +49" />
                                <core:Item key="US" text="🇺🇸 +1" />
                                <core:Item key="GB" text="🇬🇧 +44" />
                            </items>
                        </Select>

                        <Input
                            id="phoneInput"
                            type="Tel"
                            width="14rem"
                            placeholder="{i18n>phonePlaceholder}"
                            class="sapUiTinyMarginBegin" />
                    </HBox>

                    <Label
                        text="{i18n>country}" />

                    <Select
                        id="countrySelect"
                        width="100%">
                        <items>
                            <core:Item key="" text="{i18n>selectCountry}" />
                            <core:Item key="TR" text="Türkiye" />
                            <core:Item key="DE" text="Germany" />
                            <core:Item key="US" text="United States" />
                            <core:Item key="GB" text="United Kingdom" />
                        </items>
                    </Select>
                    <Label
                        text="{i18n>category}" />

                    <Select
                        id="categorySelect"
                        width="100%">
                        <items>
                            <core:Item key="" text="{i18n>selectCategory}" />
                            <core:Item key="Hardware" text="Hardware" />
                            <core:Item key="Software" text="Software" />
                            <core:Item key="Services" text="Services" />
                            <core:Item key="Consulting" text="Consulting" />
                        </items>
                    </Select>
                        </VBox>

                        <VBox width="49%">
                    <Label
                        text="{i18n>taxNumber}" />

                    <Input
                        id="taxNumberInput"
                        width="100%"
                        placeholder="{i18n>taxNumberPlaceholder}" />

                    <Label
                        text="{i18n>website}" />

                    <Input
                        id="websiteInput"
                        type="Url"
                        width="100%"
                        placeholder="{i18n>websitePlaceholder}" />

                    <Label
                        text="{i18n>address}" />

                    <TextArea
                        id="addressInput"
                        width="100%"
                        rows="3"
                        placeholder="{i18n>addressPlaceholder}" />

                    <Label
                        text="{i18n>notes}" />

                    <TextArea
                        id="notesInput"
                        width="100%"
                        rows="4"
                        placeholder="{i18n>notesPlaceholder}" />
                    </VBox>
                    </HBox>

                    <Title
                        text="{i18n>certificateSectionTitle}"
                        level="H3"
                        class="sapUiMediumMarginTop sapUiSmallMarginBottom" />

                    <MessageStrip
                        text="{i18n>certificateInfo}"
                        type="Information"
                        showIcon="true"
                        showCloseButton="false"
                        class="sapUiSmallMarginBottom" />
                        
                    <Label
                        text="{i18n>certificate}"
                        required="true" />

                    <unified:FileUploader
                        id="certificateUploader"
                        width="100%"
                        fileType="pdf"
                        maximumFileSize="10"
                        placeholder="{i18n>certificatePlaceholder}"
                        buttonText="{i18n>selectFile}"
                        typeMissmatch=".onFileTypeMismatch"
                        fileSizeExceed=".onFileSizeExceed"
                        change=".onCertificateChange" />

                    <Text
                        text="{i18n>certificateUploadHint}"
                        class="sapUiTinyMarginTop sapUiTinyMarginBottom" />

                    <Button
                        text="{i18n>submitApplication}"
                        type="Emphasized"
                        press=".onSubmitApplication"
                        class="sapUiMediumMarginTop" />
                                

                </VBox>

            </VBox>

        </content>

    </Page>

    </mvc:View>
