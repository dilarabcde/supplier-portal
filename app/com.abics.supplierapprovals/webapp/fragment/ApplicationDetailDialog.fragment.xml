<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        id="applicationDetailDialog"
        title="{selectedApplication>/companyName}"
        contentWidth="55rem"
        contentHeight="42rem"
        draggable="true"
        resizable="true"
        verticalScrolling="true">

        <content>

            <VBox class="sapUiMediumMargin">

                <!-- BAŞVURU BİLGİLERİ -->
                <Title
                    text="{i18n>applicationDetailTitle}"
                    level="H2"
                    class="sapUiSmallMarginBottom" />

                <HBox
                    width="100%"
                    justifyContent="SpaceBetween"
                    alignItems="Start">

                    <!-- SOL KOLON -->
                    <VBox width="47%">

                        <Label text="{i18n>contactPerson}" />
                        <Text
                            text="{selectedApplication>/contactPerson}"
                            class="sapUiSmallMarginBottom" />

                        <Label text="{i18n>email}" />
                        <Text
                            text="{selectedApplication>/supplierEmail}"
                            class="sapUiSmallMarginBottom" />

                        <Label text="{i18n>category}" />
                        <Text
                            text="{selectedApplication>/category}"
                            class="sapUiSmallMarginBottom" />

                        <Label text="{i18n>phone}" />
                        <HBox class="sapUiSmallMarginBottom">
                            <Text text="{selectedApplication>/phoneCountryCode}" />
                            <Text
                                text="{selectedApplication>/phoneNumber}"
                                class="sapUiTinyMarginBegin" />
                        </HBox>

                        <Label text="{i18n>country}" />
                        <Text
                            text="{selectedApplication>/country}"
                            class="sapUiSmallMarginBottom" />

                    </VBox>

                    <!-- SAĞ KOLON -->
                    <VBox width="47%">

                        <Label text="{i18n>taxNumber}" />
                        <Text
                            text="{selectedApplication>/taxNumber}"
                            class="sapUiSmallMarginBottom" />

                        <Label text="{i18n>website}" />
                        <Text
                            text="{selectedApplication>/website}"
                            class="sapUiSmallMarginBottom" />

                        <Label text="{i18n>submissionDate}" />
                        <Text
                            text="{selectedApplication>/createdAt}"
                            class="sapUiSmallMarginBottom" />

                        <Label text="{i18n>address}" />
                        <Text
                            text="{selectedApplication>/address}"
                            wrapping="true"
                            class="sapUiSmallMarginBottom" />

                        <Label text="{i18n>notes}" />
                        <Text
                            text="{selectedApplication>/notes}"
                            wrapping="true"
                            class="sapUiSmallMarginBottom" />

                    </VBox>

                </HBox>

                <!-- ONAY DURUMU -->
                <Title
                    text="{i18n>approvalStatus}"
                    level="H3"
                    class="sapUiMediumMarginTop sapUiSmallMarginBottom" />

                <Toolbar />

                <HBox
                    width="100%"
                    justifyContent="Center"
                    alignItems="Center"
                    class="sapUiMediumMarginTop sapUiMediumMarginBottom">

                    <!-- GÖNDERİLDİ -->
                    <VBox width="10rem" alignItems="Center">

                        <Avatar
                            displayShape="Circle"
                            displaySize="M"
                            src="sap-icon://document-text"
                            backgroundColor="Accent8" />

                        <Text
                            text="{i18n>submitted}"
                            class="sapUiTinyMarginTop" />

                        <ObjectStatus
                            text="{i18n>completed}"
                            state="Success"
                            class="sapUiTinyMarginTop" />

                    </VBox>

                    <core:Icon
                        src="sap-icon://navigation-right-arrow"
                        size="1.5rem"
                        class="sapUiMediumMarginBeginEnd" />

                    <!-- İNCELEMEDE -->
                    <VBox width="10rem" alignItems="Center">

                        <Avatar
                            displayShape="Circle"
                            displaySize="M"
                            src="sap-icon://inspection"
                            backgroundColor="Accent2" />

                        <Text
                            text="{i18n>underReview}"
                            class="sapUiTinyMarginTop" />

                        <ObjectStatus
                            text="{= ${selectedApplication>/status} === 'InReview' ? ${i18n>underReview} : '' }"
                            state="{= ${selectedApplication>/status} === 'InReview' ? 'Warning' : 'None' }"
                            class="sapUiTinyMarginTop" />

                    </VBox>

                    <core:Icon
                        src="sap-icon://navigation-right-arrow"
                        size="1.5rem"
                        class="sapUiMediumMarginBeginEnd" />

                    <!-- SONUÇ -->
                    <VBox width="10rem" alignItems="Center">

                        <Avatar
                            displayShape="Circle"
                            displaySize="M"
                            src="sap-icon://complete"
                            backgroundColor="Accent6" />

                        <Text
                            text="{i18n>result}"
                            class="sapUiTinyMarginTop" />

                        <ObjectStatus
                            text="{selectedApplication>/resultText}"
                            state="{selectedApplication>/resultState}"
                            class="sapUiTinyMarginTop" />

                    </VBox>

                </HBox>

                <!-- SERTİFİKA -->
                <Title
                    text="{i18n>certificate}"
                    level="H3"
                    class="sapUiMediumMarginTop sapUiSmallMarginBottom" />

                <HBox
                    alignItems="Center"
                    class="sapUiSmallMarginBottom">
                    <core:Icon
                        src="sap-icon://pdf-attachment"
                        size="1.5rem"
                        class="sapUiTinyMarginEnd" />

                    <Link
                        text="{selectedApplication>/certificateName}"
                        press=".onOpenCertificate" />

                </HBox>
                <MessageStrip
                    visible="{= !!${selectedApplication>/aiRecommendationMessage} }"
                    text="{selectedApplication>/aiRecommendationMessage}"
                    type="{selectedApplication>/aiRecommendationType}"
                    showIcon="true"
                    showCloseButton="false"
                    class="sapUiSmallMarginTop" />
                <!-- İNCELEME / KARAR ALANI -->
                <VBox
                    visible="{selectedApplication>/isInReview}"
                    class="sapUiMediumMarginTop">
                    <!-- DÜZENLENECEK ALANLAR -->
                    <Label
                        text="{i18n>revisionFields}"
                        design="Bold"
                        class="sapUiTinyMarginBottom" />

                    <MultiComboBox
                        id="revisionFields"
                        width="100%"
                        placeholder="{i18n>selectRevisionFields}"
                        selectedKeys="{selectedApplication>/fieldsToCorrect}"
                        class="sapUiSmallMarginBottom">

                        <core:Item
                            key="companyName"
                            text="{i18n>companyName}" />

                        <core:Item
                            key="contactPerson"
                            text="{i18n>contactPerson}" />

                        <core:Item
                            key="phoneNumber"
                            text="{i18n>phone}" />

                        <core:Item
                            key="country"
                            text="{i18n>country}" />

                        <core:Item
                            key="category"
                            text="{i18n>category}" />

                        <core:Item
                            key="taxNumber"
                            text="{i18n>taxNumber}" />

                        <core:Item
                            key="website"
                            text="{i18n>website}" />

                        <core:Item
                            key="address"
                            text="{i18n>address}" />

                        <core:Item
                            key="notes"
                            text="{i18n>notes}" />

                        <core:Item
                            key="certificate"
                            text="{i18n>certificate}" />

                    </MultiComboBox>

                    <!-- KARAR NOTU -->
                    <Label
                        text="{i18n>decisionNote}"
                        design="Bold"
                        class="sapUiSmallMarginTop sapUiTinyMarginBottom" />

                    <TextArea
                        id="decisionNote"
                        width="100%"
                        rows="3"
                        maxLength="1000"
                        value="{selectedApplication>/decisionNote}"
                        placeholder="{i18n>decisionNotePlaceholder}" />
                </VBox>

            </VBox>
        </content>

        <buttons>

            <Button
                text="{i18n>startReview}"
                type="Emphasized"
                visible="{selectedApplication>/isSubmitted}"
                press=".onStartReview" />

            <Button
                text="{i18n>aiAnalyze}"
                icon="sap-icon://activate"
                type="Emphasized"
                visible="{selectedApplication>/isInReview}"
                press=".onAIAnalyze" />

            <Button
                text="{i18n>approve}"
                icon="sap-icon://accept"
                type="Accept"
                visible="{selectedApplication>/isInReview}"
                press=".onApproveApplication" />

            <Button
                text="{i18n>reject}"
                icon="sap-icon://decline"
                type="Reject"
                visible="{selectedApplication>/isInReview}"
                press=".onRejectApplication" />

            <Button
                text="{i18n>close}"
                press=".onCloseApplicationDialog" />

        </buttons>

    </Dialog>

</core:FragmentDefinition>