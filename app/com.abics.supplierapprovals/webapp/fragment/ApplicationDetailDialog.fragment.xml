<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        id="applicationDetailDialog"
        title="{selectedApplication>/companyName}"
        contentWidth="50rem"
        contentHeight="35rem"
        draggable="true"
        resizable="true">

        <content>

            <VBox class="sapUiMediumMargin">

                <!-- BAŞVURU BİLGİLERİ -->
                <Title
                    text="{i18n>applicationDetailTitle}"
                    level="H2"
                    class="sapUiSmallMarginBottom" />

                <HBox
                    width="100%"
                    justifyContent="SpaceBetween"
                    alignItems="Start">

                    <!-- SOL KOLON -->
                    <VBox width="47%">

                        <Label text="{i18n>contactPerson}" />
                        <Text
                            text="{selectedApplication>/contactPerson}"
                            class="sapUiSmallMarginBottom" />

                        <Label text="{i18n>email}" />
                        <Text
                            text="{selectedApplication>/supplierEmail}"
                            class="sapUiSmallMarginBottom" />

                        <Label text="{i18n>category}" />
                        <Text
                            text="{selectedApplication>/category}"
                            class="sapUiSmallMarginBottom" />

                        <Label text="{i18n>phone}" />

                        <HBox class="sapUiSmallMarginBottom">
                            <Text text="{selectedApplication>/phoneCountryCode}" />
                            <Text
                                text="{selectedApplication>/phoneNumber}"
                                class="sapUiTinyMarginBegin" />
                        </HBox>

                        <Label text="{i18n>country}" />
                        <Text
                            text="{selectedApplication>/country}"
                            class="sapUiSmallMarginBottom" />

                    </VBox>

                    <!-- SAĞ KOLON -->
                    <VBox width="47%">

                        <Label text="{i18n>taxNumber}" />
                        <Text
                            text="{selectedApplication>/taxNumber}"
                            class="sapUiSmallMarginBottom" />

                        <Label text="{i18n>website}" />
                        <Text
                            text="{selectedApplication>/website}"
                            class="sapUiSmallMarginBottom" />

                        <Label text="{i18n>submissionDate}" />
                        <Text
                            text="{selectedApplication>/createdAt}"
                            class="sapUiSmallMarginBottom" />

                        <Label text="{i18n>address}" />
                        <Text
                            text="{selectedApplication>/address}"
                            wrapping="true"
                            class="sapUiSmallMarginBottom" />

                        <Label text="{i18n>notes}" />
                        <Text
                            text="{selectedApplication>/notes}"
                            wrapping="true"
                            class="sapUiSmallMarginBottom" />

                    </VBox>

                </HBox>
                <!-- ONAY DURUMU -->
                <VBox class="sapUiMediumMarginTop">

                    <Title
                        text="{i18n>approvalStatus}"
                        level="H3"
                        class="sapUiSmallMarginBottom" />

                    <Toolbar />

                    <HBox
                        width="100%"
                        justifyContent="Center"
                        alignItems="Center"
                        class="sapUiMediumMarginTop sapUiMediumMarginBottom">

                        <!-- 1. GÖNDERİLDİ -->
                        <VBox
                            width="10rem"
                            alignItems="Center">

                            <Avatar
                                displayShape="Circle"
                                displaySize="M"
                                src="sap-icon://document-text"
                                backgroundColor="Accent8" />

                            <Text
                                text="{i18n>submitted}"
                                class="sapUiTinyMarginTop" />

                            <ObjectStatus
                                text="{i18n>completed}"
                                state="Success"
                                class="sapUiTinyMarginTop" />

                        </VBox>

                        <!-- OK -->
                        <core:Icon
                            src="sap-icon://navigation-right-arrow"
                            size="1.5rem"
                            class="sapUiMediumMarginBeginEnd" />

                        <!-- 2. İNCELEMEDE -->
                        <VBox
                            width="10rem"
                            alignItems="Center">

                            <Avatar
                                displayShape="Circle"
                                displaySize="M"
                                src="sap-icon://inspection"
                                backgroundColor="Accent2" />

                            <Text
                                text="{i18n>underReview}"
                                class="sapUiTinyMarginTop" />

                            <ObjectStatus
                                text="{selectedApplication>/reviewText}"
                                state="{selectedApplication>/reviewState}"
                                class="sapUiTinyMarginTop" />

                        </VBox>

                        <!-- OK -->
                        <core:Icon
                            src="sap-icon://navigation-right-arrow"
                            size="1.5rem"
                            class="sapUiMediumMarginBeginEnd" />

                        <!-- 3. SONUÇ -->
                        <VBox
                            width="10rem"
                            alignItems="Center">

                            <Avatar
                                displayShape="Circle"
                                displaySize="M"
                                src="sap-icon://complete"
                                backgroundColor="Accent6" />

                            <Text
                                text="{i18n>result}"
                                class="sapUiTinyMarginTop" />

                            <ObjectStatus
                                text="{selectedApplication>/resultText}"
                                state="{selectedApplication>/resultState}"
                                class="sapUiTinyMarginTop" />

                        </VBox>

                    </HBox>

                </VBox>

                <!-- SERTİFİKA -->
                <Title
                    text="{i18n>certificate}"
                    level="H3"
                    class="sapUiMediumMarginTop sapUiSmallMarginBottom" />

                <HBox
                    alignItems="Center"
                    visible="{= !!${selectedApplication>/certificateName} }">

                    <core:Icon
                        src="sap-icon://pdf-attachment"
                        size="1.5rem"
                        class="sapUiTinyMarginEnd" />

                    <Text
                        text="{selectedApplication>/certificateName}" />

                </HBox>

            </VBox>

        </content>
        <beginButton>
            <Button
                text="{i18n>startReview}"
                type="Emphasized"
                visible="{= ${selectedApplication>/status} === 'Submitted' }"
                press=".onStartReview" />
        </beginButton>

        <endButton>
            <Button
                text="{i18n>close}"
                press=".onCloseApplicationDialog" />
        </endButton>

    </Dialog>

</core:FragmentDefinition>