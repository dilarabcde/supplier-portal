<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        id="supplierHistoryDialog"
        title="{i18n>supplierHistoryTitle}"
        contentWidth="55rem"
        contentHeight="40rem"
        stretchOnPhone="true"
        verticalScrolling="true">

        <content>

            <VBox class="sapUiMediumMargin">

                <!-- GÜNCEL ONAYLI TEDARİKÇİ -->

                <Title
                    text="{supplierHistory>/companyName}"
                    level="H2" />

                <ObjectStatus
                    text="{i18n>approvedSupplier}"
                    state="Success"
                    icon="sap-icon://accept"
                    class="sapUiTinyMarginTop sapUiSmallMarginBottom" />

                <HBox
                    width="100%"
                    justifyContent="SpaceBetween"
                    wrap="Wrap">

                    <VBox width="48%">

                        <Label text="{i18n>contactPerson}" />
                        <Text
                            text="{supplierHistory>/contactPerson}"
                            class="sapUiSmallMarginBottom" />

                        <Label text="{i18n>email}" />
                        <Text
                            text="{supplierHistory>/supplierEmail}"
                            class="sapUiSmallMarginBottom" />

                        <Label text="{i18n>category}" />
                        <Text
                            text="{supplierHistory>/category}"
                            class="sapUiSmallMarginBottom" />

                        <Label text="{i18n>taxNumber}" />
                        <Text
                            text="{supplierHistory>/taxNumber}"
                            class="sapUiSmallMarginBottom" />

                        <Label text="{i18n>firstApplicationDate}" />
                        <Text
                            text="{supplierHistory>/formattedCreatedAt}" />

                    </VBox>

                    <VBox width="48%">

                        <Label text="{i18n>phone}" />

                        <HBox class="sapUiSmallMarginBottom">
                            <Text text="{supplierHistory>/phoneCountryCode}" />
                            <Text
                                text="{supplierHistory>/phoneNumber}"
                                class="sapUiTinyMarginBegin" />
                        </HBox>

                        <Label text="{i18n>country}" />
                        <Text
                            text="{supplierHistory>/countryText}"
                            class="sapUiSmallMarginBottom" />

                        <Label text="{i18n>website}" />
                        <Text
                            text="{supplierHistory>/website}"
                            class="sapUiSmallMarginBottom" />

                        <Label text="{i18n>address}" />
                        <Text
                            text="{supplierHistory>/address}"
                            wrapping="true"
                            class="sapUiSmallMarginBottom" />

                        <Label text="{i18n>lastUpdated}" />
                        <Text
                            text="{supplierHistory>/formattedModifiedAt}" />

                    </VBox>

                </HBox>

                <!-- SERTİFİKA -->

                <Title
                    text="{i18n>certificate}"
                    level="H3"
                    class="sapUiMediumMarginTop sapUiSmallMarginBottom" />

                <HBox
                    visible="{supplierHistory>/hasCertificate}"
                    alignItems="Center">

                    <core:Icon
                        src="sap-icon://pdf-attachment"
                        size="1.5rem"
                        class="sapUiTinyMarginEnd" />

                    <Link
                        text="{supplierHistory>/certificateName}"
                        press=".onOpenSupplierCertificate" />

                </HBox>

                <Text
                    text="{i18n>certificateNotFound}"
                    visible="{= !${supplierHistory>/hasCertificate} }" />

                <!-- BAŞVURU GEÇMİŞİ -->

                <Title
                    text="{i18n>applicationHistory}"
                    level="H3"
                    class="sapUiMediumMarginTop sapUiSmallMarginBottom" />

                <List
                    items="{supplierHistory>/history}"
                    showSeparators="None"
                    noDataText="{i18n>noApplicationHistory}">

                    <CustomListItem>

                        <VBox width="100%">

                            <HBox
                                width="100%"
                                alignItems="Start"
                                class="sapUiSmallMarginTop sapUiSmallMarginBottom">

                                <!-- DURUM İKONU -->
                                <VBox
                                    width="3rem"
                                    alignItems="Center"
                                    class="sapUiTinyMarginTop">

                                    <core:Icon
                                        src="{= ${supplierHistory>isApproved}
                                            ? 'sap-icon://accept'
                                            : ${supplierHistory>isRejected}
                                                ? 'sap-icon://decline'
                                                : ${supplierHistory>isSubmitted}
                                                    ? 'sap-icon://accept'
                                                    : 'sap-icon://pending' }"
                                        color="{= ${supplierHistory>isApproved}
                                            ? '#30914C'
                                            : ${supplierHistory>isRejected}
                                                ? '#BB0000'
                                                : ${supplierHistory>isSubmitted}
                                                    ? '#30914C'
                                                    : '#E78C07' }"
                                        size="1.25rem" />

                                </VBox>

                                <!-- İÇERİK -->
                                <VBox width="100%">

                                    <HBox
                                        width="100%"
                                        justifyContent="SpaceBetween"
                                        alignItems="Center">

                                        <ObjectStatus
                                            text="{supplierHistory>statusText}"
                                            state="{= ${supplierHistory>isRejected}
                                                ? 'Error'
                                                : ${supplierHistory>isApproved}
                                                    ? 'Success'
                                                    : ${supplierHistory>isSubmitted}
                                                        ? 'Success'
                                                        : 'Warning' }" />

                                        <Text
                                            text="{supplierHistory>formattedDate}" />

                                    </HBox>

                                    <Text
                                        text="{= ${i18n>action} + ': ' + ${supplierHistory>actionText} }"
                                        class="sapUiTinyMarginTop" />

                                    <!-- SADECE REDDEDİLDİYSE -->
                                    <VBox
                                        visible="{supplierHistory>isRejected}"
                                        class="sapUiSmallMarginTop">

                                        <Label
                                            text="{i18n>rejectionReason}"
                                            design="Bold" />

                                        <Text
                                            text="{supplierHistory>reason}"
                                            wrapping="true"
                                            class="sapUiTinyMarginTop sapUiSmallMarginBottom" />

                                        <VBox
                                            visible="{supplierHistory>hasRevisionFields}">

                                            <Label
                                                text="{i18n>requestedRevisionFields}"
                                                design="Bold" />

                                            <List
                                                items="{
                                                    path: 'supplierHistory>revisionFieldsArray',
                                                    templateShareable: false
                                                }"
                                                showSeparators="None">

                                            <StandardListItem
                                                title="{supplierHistory>text}"
                                                icon="sap-icon://edit" />

                                            </List>

                                        </VBox>

                                    </VBox>

                                </VBox>

                            </HBox>

                            <!-- İSTASYONLAR ARASINDAKİ İNCE AYIRICI -->
                            <Toolbar
                                design="Transparent"
                                height="1px" />

                        </VBox>

                    </CustomListItem>

                </List>

            </VBox>

        </content>

        <beginButton>
            <Button
                text="{i18n>close}"
                press=".onCloseSupplierHistory" />
        </beginButton>

    </Dialog>

</core:FragmentDefinition>