<mvc:View
    controllerName="com.abics.supplierapprovals.controller.Approver"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">

    <Page
        id="approverPage"
        title="{i18n>approverPageTitle}">

        <content>

            <!-- Banner -->
            <Image
                src="/com.abics.supplierapprovals/webapp/images/bremen-main.jpeg"
                 height="23rem"
                width="100%"
                densityAware="false"
                decorative="false"
                alt="{i18n>approverBannerAlt}" />

<VBox class="sapUiMediumMarginBeginEnd">

<HBox
    width="100%"
    justifyContent="Center"
    alignItems="Center"
    class="sapUiSmallMarginTop sapUiSmallMarginBottom">

    <!-- TÜM BAŞVURULAR -->
    <GenericTile
        frameType="TwoByHalf"
        width="19rem"
        header="{i18n>allApplications}"
        press=".onFilterApplications"
        class="sapUiTinyMarginBeginEnd">

        <customData>
            <core:CustomData key="status" value="" />
        </customData>

        <TileContent>
            <NumericContent
                value="{approver>/counts/all}"
                icon="sap-icon://list"
                valueColor="Neutral" />
        </TileContent>
    </GenericTile>


    <!-- BEKLEYEN -->
    <GenericTile
        frameType="TwoByHalf"
        width="19rem"
        header="{i18n>pendingApplications}"
        press=".onFilterApplications"
        class="sapUiTinyMarginBeginEnd">

        <customData>
            <core:CustomData key="status" value="Pending" />
        </customData>

        <TileContent>
            <NumericContent
                value="{approver>/counts/pending}"
                icon="sap-icon://pending"
                valueColor="Critical" />
        </TileContent>
    </GenericTile>


    <!-- ONAYLANAN -->
    <GenericTile
        frameType="TwoByHalf"
        width="19rem"
        header="{i18n>approvedApplications}"
        press=".onFilterApplications"
        class="sapUiTinyMarginBeginEnd">

        <customData>
            <core:CustomData key="status" value="Approved" />
        </customData>

        <TileContent>
            <NumericContent
                value="{approver>/counts/approved}"
                icon="sap-icon://accept"
                valueColor="Good" />
        </TileContent>
    </GenericTile>


    <!-- REDDEDİLEN -->
    <GenericTile
        frameType="TwoByHalf"
        width="19rem"
        header="{i18n>rejectedApplications}"
        press=".onFilterApplications"
        class="sapUiTinyMarginBeginEnd">

        <customData>
            <core:CustomData key="status" value="Rejected" />
        </customData>

        <TileContent>
            <NumericContent
                value="{approver>/counts/rejected}"
                icon="sap-icon://decline"
                valueColor="Error" />
        </TileContent>
    </GenericTile>


    <!-- TÜM TEDARİKÇİLER -->
    <GenericTile
        frameType="TwoByHalf"
        width="19rem"
        header="{i18n>allSuppliers}"
        press=".onShowSuppliers"
        class="sapUiTinyMarginBeginEnd">

        <TileContent>
            <NumericContent
                value="{approver>/counts/suppliers}"
                icon="sap-icon://group"
                valueColor="Neutral" />
        </TileContent>
    </GenericTile>

</HBox>
                <!-- Başvurular -->
                <Table
                    id="applicationsTable"
                    width="100%"
                    items="{approver>/applications}"
                    noDataText="{i18n>noApplicationsFound}">

                <headerToolbar>
                <Toolbar>
                    <Title
                        text="{i18n>applications}" />

                    <ToolbarSpacer />

                    <SearchField
                        width="18rem"
                        placeholder="{i18n>searchApplications}"
                        liveChange=".onSearchApplications" />

                    <Button
                        icon="sap-icon://action-settings"
                        type="Transparent"
                        tooltip="{i18n>settings}"
                        press=".onOpenSettings" />

                    <Button
                        icon="sap-icon://refresh"
                        type="Transparent"
                        press=".onRefresh" />
                </Toolbar>
                </headerToolbar>

<columns>

    <!-- No -->
    <Column width="4rem">
        <Text text="{i18n>number}" />
    </Column>

    <!-- Company -->
    <Column id="companyColumn">
        <Text text="{i18n>company}" />
    </Column>

    <!-- Contact Person -->
    <Column id="contactPersonColumn">
        <Text text="{i18n>contactPerson}" />
    </Column>

    <!-- Email -->
    <Column id="emailColumn">
        <Text text="{i18n>email}" />
    </Column>

    <!-- Phone -->
    <Column id="phoneColumn" visible="false">
        <Text text="{i18n>phone}" />
    </Column>

    <!-- Country -->
    <Column id="countryColumn" visible="false">
        <Text text="{i18n>country}" />
    </Column>

    <!-- Category -->
    <Column id="categoryColumn">
        <Text text="{i18n>category}" />
    </Column>

    <!-- Tax Number -->
    <Column id="taxNumberColumn" visible="false">
        <Text text="{i18n>taxNumber}" />
    </Column>

    <!-- Website -->
    <Column id="websiteColumn" visible="false">
        <Text text="{i18n>website}" />
    </Column>

    <!-- Address -->
    <Column id="addressColumn" visible="false">
        <Text text="{i18n>address}" />
    </Column>

    <!-- Notes -->
    <Column id="notesColumn" visible="false">
        <Text text="{i18n>notes}" />
    </Column>

    <!-- Submission Date -->
    <Column id="submissionDateColumn" visible="false">
        <Text text="{i18n>submissionDate}" />
    </Column>

    <!-- Status -->
    <Column id="statusColumn">
        <Text text="{i18n>status}" />
    </Column>

    <!-- Arrow -->
    <Column
        width="3rem"
        hAlign="Center" />

</columns>

                    <items>
                        <ColumnListItem>

                            <cells>
                                <ObjectNumber number="{approver>rowNumber}" />
                                <Text text="{approver>companyName}" />

                                <Text text="{approver>contactPerson}" />

                                <Text text="{approver>supplierEmail}" />

                                <Text text="{= ${approver>phoneCountryCode} + ' ' + ${approver>phoneNumber} }" />

                                <Text text="{approver>country}" />

                                <Text text="{approver>category}" />

                                <Text text="{approver>taxNumber}" />

                                <Text text="{approver>website}" />

                                <Text text="{approver>address}" />

                                <Text text="{approver>notes}" />

                                <Text text="{path: 'approver>createdAt', formatter: '.formatDateTime'}" />
                                <ObjectStatus
                                    text="{approver>statusText}" />
                                <Button
                                    icon="sap-icon://navigation-right-arrow"
                                    type="Transparent"
                                    tooltip="{i18n>viewApplicationDetails}"
                                    press=".onApplicationPress" />

                            </cells>

                        </ColumnListItem>

                    </items>
        </Table>

</VBox>

</content>
</Page>

</mvc:View>