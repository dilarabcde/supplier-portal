{
  "welcomeFile": "/fiori-apps.html",
  "authenticationMethod": "none",
  "routes": [
    {
      "source": "^/odata/(.*)$",
      "target": "/odata/$1",
      "destination": "cap-backend",
      "authenticationType": "none"
    },
    {
      "source": "^/com\\.abics\\.supplierportal/(.*)$",
      "target": "/com.abics.supplierportal/$1",
      "destination": "cap-backend",
      "authenticationType": "none"
    },
    {
      "source": "^/com\\.abics\\.supplierapprovals/(.*)$",
      "target": "/com.abics.supplierapprovals/$1",
      "destination": "cap-backend",
      "authenticationType": "none"
    },
    {
      "source": "^/(.*)$",
      "target": "$1",
      "localDir": ".",
      "authenticationType": "none"
    }
  ]
}